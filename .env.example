# kingfisher deployment settings. Copy to .env (read from the working directory)
# and fill in. Everything is optional but KINGFISHER_WORKSPACE and
# KINGFISHER_DEFINITIONS_DIR; `kingfisher doctor` reports what is set, missing, or
# retired.

# --- credentials ------------------------------------------------------------
# Each endpoint in models.yaml names where its key comes from: `key:` an entry
# in the keys file, or `key_env:` a variable (set here, or by a container/CI).
# The keys file has no default; a relative path is from the working directory.
# Keep it out of the workspace and the definitions folder, and on macOS under your
# home, where the sandbox hides it -- docs/guides/configuration.md, *What each fence
# hides*. `kingfisher seed` writes a keys.yaml.example to copy out. A missing key
# drops its endpoint.
# KINGFISHER_MODEL_KEYS_FILE=~/.config/kingfisher/keys.yaml

# --- definitions ------------------------------------------------------------
# What people write: agents/, middlewares/, skills/, subagents/, tools/, and beside
# them models.yaml (where prompts go and what runs there; start from
# models.yaml.example) and source_ids.yaml (writing one turns source-id access on).
# Shared by every deployment pointed at it, and never written by one that starts:
# `kingfisher seed` makes and fills it. ABSOLUTE path, apart from the workspace.
KINGFISHER_DEFINITIONS_DIR=/absolute/path/to/kingfisher-definitions
# Where `kingfisher seed` copies definitions FROM (relative to the working dir):
# the assets this repository ships. Definitions from another project live outside
# the checkout and are seeded with a second `kingfisher seed --from`.
KINGFISHER_ASSETS=./assets
# Wire formats of your own: module:name returning {name: kingfisher.Adapter}.
# KINGFISHER_ADAPTERS_FACTORY=mycompany.models:adapters
# More skills directories as label=path pairs, offered at /skills/<label>/.
# KINGFISHER_SKILLS_MOUNTS=vendor=/opt/vendor/skills:team=/srv/team/skills

# --- workspace --------------------------------------------------------------
# What sessions make: sessions/ and kingfisher's own .kingfisher/. One process, one
# workspace. ABSOLUTE path, outside this repo (~ is not stable).
KINGFISHER_WORKSPACE=/absolute/path/to/kingfisher-workspace

# --- sessions ---------------------------------------------------------------
# Sessions for the `kingfisher` command when not its own: module:name returning a
# kingfisher Sessions. Unset: directories under <workspace>/sessions.
# KINGFISHER_SESSIONS=mycompany.sessions:build_sessions
# The other plugins the command hands every Kingfisher it builds: module:name
# returning kingfisher.Plugins -- run events, a conversation store, middleware.
# Unset: kingfisher's own of each.
# KINGFISHER_PLUGINS=mycompany.plugins:build_plugins
# Which session a turn runs in is the request's to say -- `kingfisher run --session
# ID` -- and a request naming none runs in the session called `default`.

# --- the shell --------------------------------------------------------------
# Extra directories on the agent shell's PATH (it runs with an allowlist, not
# the parent environment); Homebrew tools live in /opt/homebrew/bin on macOS.
# KINGFISHER_SHELL_PATH_EXTRA=/opt/homebrew/bin

# --- limits -----------------------------------------------------------------
# One shell command or interpreter run (not the model timeout, per-model in yaml).
# KINGFISHER_EXECUTION_TIMEOUT_S=120
# Graph steps per turn (each agent turn costs two or three).
# KINGFISHER_RECURSION_LIMIT=150
# Threads astream/arun hand blocking work to; one pool per process.
# KINGFISHER_THREAD_POOL_SIZE=16
# A turn's wall clock; on breach it stops between steps and returns what it has.
# KINGFISHER_TURN_TIMEOUT_S=3600
# Disk one session may hold; unset is unbounded, checked before a turn.
# KINGFISHER_SESSION_MAX_BYTES=1073741824
# Idle age `kingfisher reap` uses when not told one; nothing sweeps on a schedule.
# KINGFISHER_SESSION_TTL_S=604800

# --- capabilities (each gates a middleware AND its prompt section) -----------
# Whether a turn remembers the one before it. On by default.
# KINGFISHER_CONVERSATION_ENABLED=false
# KINGFISHER_SKILLS_ENABLED=true
# KINGFISHER_MEMORY_ENABLED=true
# A JS sandbox the agent computes in: no filesystem, no network, capped.
# KINGFISHER_INTERPRETER_ENABLED=true

# --- the shell's fence ------------------------------------------------------
# Who keeps `execute` off the rest of the host. A real shell runs with your
# permissions; unconfined it can read .env, ~/.aws, ~/.config/gh. auto (default)
# | bubblewrap | external | off. `kingfisher doctor` says what engaged.
# KINGFISHER_SHELL_SANDBOX=auto

# --- retired: read by nothing; `kingfisher doctor` reports any still set -----
# Listed to the left of an arrow, so this file does not re-advertise a dead name
# as an assignment.
#   KINGFISHER_SKILLS            -> KINGFISHER_SKILLS_ENABLED
#   KINGFISHER_MEMORY            -> KINGFISHER_MEMORY_ENABLED
#   KINGFISHER_INTERPRETER       -> KINGFISHER_INTERPRETER_ENABLED
#   KINGFISHER_CONVERSATION      -> KINGFISHER_CONVERSATION_ENABLED
#   KINGFISHER_API_STYLE         -> models.yaml, the endpoint's wire format
#   KINGFISHER_MODEL             -> models.yaml, where a model names its endpoint
#   KINGFISHER_MAX_TOKENS        -> models.yaml, beside the model it bounds
#   KINGFISHER_TIMEOUT_S         -> KINGFISHER_EXECUTION_TIMEOUT_S, timeout_s per model
#   KINGFISHER_MODEL_SUBAGENT    -> model: in the subagent's own .yaml
#   KINGFISHER_PROVIDER_SUBAGENT -> the endpoint that model names
#   KINGFISHER_STATE_DIR         -> nothing; claims and pinned agents are in the session
#   KINGFISHER_SCRATCH_DIR       -> nothing; TMPDIR is a directory inside the session
#   KINGFISHER_SESSION_KEY       -> nothing; a session's files are no longer signed
# Removed and refused if still set: KINGFISHER_SESSION_STORE,
# KINGFISHER_SESSION_STORE_FACTORY, KINGFISHER_BACKEND_FACTORY and
# KINGFISHER_SESSION_ID, whose session a request now names itself; and the seven
# that each moved one thing out of the workspace -- KINGFISHER_AGENTS_DIR,
# _MIDDLEWARES_DIR, _SKILLS_DIR, _SUBAGENTS_DIR, _TOOLS_DIR, KINGFISHER_MODELS_FILE
# and KINGFISHER_SOURCE_IDS_FILE -- whose things are all in the definitions folder.
# The removed HTTP service read KINGFISHER_SERVER_* and KINGFISHER_SERVICE_*.
