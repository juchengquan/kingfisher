# --- endpoint credentials ---------------------------------------------------
# Fill in whichever style you intend to use. The two styles reach different
# places -- see KINGFISHER_API_STYLE below.

# The gateway path: any endpoint imitating Anthropic's wire format.
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_API_KEY=${YOUR_API_KEY}

# OpenAI proper, on the Responses API. Set explicitly rather than left to the
# library default: kingfisher never has an unstated destination for your
# prompts, files and key.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=${YOUR_API_KEY}

# --- kingfisher -------------------------------------------------------------

# Which endpoint style to use. Required, and deliberately without a default --
# these are two different destinations, not two dialects of one:
#
#   anthropic  Anthropic's wire format. This is the gateway path; MiniMax and
#              anything else imitating it goes here.
#   openai     OpenAI proper, on the Responses API (/v1/responses). NOT a
#              general OpenAI-compatible client -- gateways do not implement
#              that endpoint, so point them at the anthropic style instead.
#
# Against MiniMax specifically the anthropic style is also the better one: its
# OpenAI-compatible endpoint wraps answers in <think> tags, at several times
# the output tokens.
KINGFISHER_API_STYLE=anthropic

KINGFISHER_MODEL=MiniMax-M3

# One process serves one workspace. Kept outside this repository so runtime
# state does not land in kingfisher's own tree.
#
# Use an ABSOLUTE path: `~` resolves against HOME, which is not stable in
# every execution context, and a workspace that silently relocates takes its
# sessions, memory and skills with it.
#
# A workspace is runtime state and kingfisher versions none of it -- it runs no
# git and writes no .gitignore. What is worth keeping is the authored tier,
# `skills/`, `subagents/` and `tools/`, and each relocates on its own below;
# point them at a directory you version and the sessions stay disposable.
KINGFISHER_WORKSPACE=/absolute/path/to/kingfisher-workspace

# Where host-side state lives. Both default to inside the workspace, which is
# what keeps a workspace self-contained and copyable. Only these two can move:
# everything else (/data, /derived, /skills, /subagents, /memory, /runs) is
# addressed by the agent through virtual paths, and file tools are routed while
# the shell is not -- so a split root would give the two different views of the
# same name.
#
#   STATE_DIR    run logs and the thread database   default <workspace>/.kingfisher
#   SCRATCH_DIR  the shell's TMPDIR                 default <STATE_DIR>/tmp
#
# Point SCRATCH_DIR at /tmp for one fixed location per machine. It is created
# 0700 and rejected if it is not ours or is group/world-accessible: /tmp is
# mode 1777, so anything derived from /data would otherwise be readable by
# every local user, and another user can pre-create the name.
# KINGFISHER_STATE_DIR=/absolute/path/to/state
# KINGFISHER_SCRATCH_DIR=/tmp/kingfisher

# Where the skill and subagent definitions live. Both default to inside the
# workspace, which is where they have always been. Point several deployments at
# one directory and they share a reviewed catalogue instead of each keeping a
# copy nobody can audit centrally -- these hold content a person authored, so
# unlike the session directories they are meant to be shared.
#
# They relocate independently: share the procedures while keeping your own
# delegates, or the reverse.
#
# TOOLS_DIR is the same idea for the Python modules a workspace adds to the
# built-in tool set. It is the one catalogue that is *code*: it is imported
# into this process and is deliberately not a backend route, so no file tool
# reaches it. Point several deployments at one directory and they share a
# reviewed set of tools.
# KINGFISHER_SKILLS_DIR=/absolute/path/to/catalogue/skills
# KINGFISHER_SUBAGENTS_DIR=/absolute/path/to/catalogue/subagents
# KINGFISHER_TOOLS_DIR=/absolute/path/to/catalogue/tools

# Extra directories on the agent shell's PATH, colon-separated.
#
# The shell runs with an explicit allowlist rather than the parent environment,
# so it cannot read credentials out of it -- which also means it resolves only
# what is on that list: the project's own bin, then /usr/bin:/bin:/usr/sbin:/sbin.
# Anything installed elsewhere is invisible until named here, and the failure
# looks like the tool not existing rather than like a PATH problem.
#
# Homebrew is the usual case on macOS: pdftotext, ripgrep, jq and friends all
# live in /opt/homebrew/bin.
# KINGFISHER_SHELL_PATH_EXTRA=/opt/homebrew/bin

# Which model a delegate runs, and where, is not set here. It is two optional
# lines in the subagent's own .yaml:
#
#     provider: openai      # any style whose *_BASE_URL and *_API_KEY are set above
#     model: gpt-5
#
# Omit both and it runs on KINGFISHER_MODEL, at the endpoint above. There was a
# KINGFISHER_MODEL_SUBAGENT / KINGFISHER_PROVIDER_SUBAGENT pair here; it could
# only ever say "every delegate", which is the wrong granularity for a cost
# decision and quietly broke the one delegate whose job is to be a different
# model. Per-delegate is the .yaml. See presets/README.md.

# Optional
# KINGFISHER_MAX_TOKENS=4096
# KINGFISHER_TIMEOUT_S=120
# KINGFISHER_RECURSION_LIMIT=150

# What one session may consume. Session-scoped because that is what kingfisher
# can see -- it does not know who is calling, so bounding a *caller* belongs to
# whatever does. These protect the process from one runaway session.
#
# A turn's wall clock. RECURSION_LIMIT bounds graph steps and TIMEOUT_S bounds a
# single model call or shell command; nothing bounded their product, so a turn
# could hold a process for 150 x 120s ~= 5 hours. An hour is far past any real
# turn, so this only fires on the pathological case. On breach the turn stops
# between steps and returns what it produced, marked -- its files are on disk
# and in the result's manifest either way.
# KINGFISHER_TURN_TIMEOUT_S=3600
#
# How much disk one session may hold. Unset by default: workspaces vary by
# orders of magnitude and refusing a turn over a number nobody chose is worse
# than not bounding it. Checked before a turn starts, never during -- the shell
# writes without any file tool seeing it, so there is nothing to intercept.
# KINGFISHER_SESSION_MAX_BYTES=1073741824
#
# How long an idle session survives, when a janitor calls `reap()` without
# saying. Age rather than a count of sessions kept: how long one has been idle
# is a property of that session, where "newest twenty" compares every caller's
# against each other.
# KINGFISHER_SESSION_TTL_S=604800

# Whether a turn remembers the one before it. On by default, because a session
# that forgets is a surprising default for something that hands out session ids.
#
# Off makes a deployment stateless in the only sense kingfisher can be: no
# checkpointer, so no database, nothing to contend on, orphan or vacuum. Files
# are unaffected -- /data, /derived and /memory are on disk and a resumed
# session still finds them. It is the conversation that goes, so --session still
# names the same files while the agent starts each turn cold.
#
# Worth turning off for a request/response API, where a caller sends one task
# and reads one answer and never follows up.
# KINGFISHER_CONVERSATION=false

# M2 capabilities. Each flag gates the middleware AND its prompt section, so
# the agent is never told about something it cannot actually do.
# KINGFISHER_SKILLS=true
# KINGFISHER_MEMORY=true

# A JavaScript sandbox the agent can compute in: capped memory and time, no
# filesystem, no network, and reachable tools limited to what the request
# granted. The one execution surface `execute` can never be, which is why a
# deployment may want both.
#
# Dispatching subagents from inside it needs the async path -- `task()` in the
# REPL awaits, and a sync saver raises partway through a workflow.
# KINGFISHER_INTERPRETER=true

# Who keeps `execute` off the rest of the host. The shell is a real shell: it
# runs with your permissions and reaches any file you can, whatever the file
# tools are rooted at. Measured unconfined, it could read this deployment's own
# API keys out of .env, plus ~/.aws and ~/.config/gh -- and `http_fetch` is one
# tool call away from sending them somewhere.
#
# It also enforces the two rules the prompt could only ask for. A single
# observed run wrote a literal /tmp/preview.pdf and twice tried `pip install`,
# both of which system.md tells it not to do; writes are now denied outside the
# workspace and $TMPDIR, so those fail rather than being requested politely.
#
#   auto      (default) use whatever the platform offers. macOS: sandbox-exec,
#             denying your home directory while keeping the workspace, the venv
#             and the interpreter readable, and denying writes anywhere but the
#             workspace, $TMPDIR and /dev. Elsewhere: nothing yet, and it says so.
#   external  a container already mounts only the workspace, so nothing is
#             wrapped and nothing is warned about.
#   off       deliberately unconfined. Warned about on every start.
# KINGFISHER_SHELL_SANDBOX=auto
