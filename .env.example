# --- endpoint credentials ---------------------------------------------------
# Fill in whichever style you intend to use. The two styles reach different
# places -- see KINGFISHER_API_STYLE below.

# The gateway path: any endpoint imitating Anthropic's wire format.
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_API_KEY=${YOUR_API_KEY}

# OpenAI proper, on the Responses API. Set explicitly rather than left to the
# library default: kingfisher never has an unstated destination for your
# prompts, files and key.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=${YOUR_API_KEY}

# --- kingfisher -------------------------------------------------------------

# Which endpoint style to use. Required, and deliberately without a default --
# these are two different destinations, not two dialects of one:
#
#   anthropic  Anthropic's wire format. This is the gateway path; MiniMax and
#              anything else imitating it goes here.
#   openai     OpenAI proper, on the Responses API (/v1/responses). NOT a
#              general OpenAI-compatible client -- gateways do not implement
#              that endpoint, so point them at the anthropic style instead.
#
# Against MiniMax specifically the anthropic style is also the better one: its
# OpenAI-compatible endpoint wraps answers in <think> tags, at several times
# the output tokens.
KINGFISHER_API_STYLE=anthropic

KINGFISHER_MODEL=MiniMax-M3

# One process serves one workspace. Kept outside this repository so the
# workspace's own git repo is not nested inside kingfisher's.
# Use an ABSOLUTE path: `~` resolves against HOME, which is not stable in
# every execution context, and a workspace that silently relocates takes
# its git history, memory and skills with it.
KINGFISHER_WORKSPACE=/absolute/path/to/kingfisher-workspace

# Optional
# KINGFISHER_MODEL_SUBAGENT=MiniMax-M2.5   # per-role routing, when cost warrants it
# KINGFISHER_KEEP_RUNS=20                  # run directories retained (also the resume window)
# KINGFISHER_MAX_TOKENS=4096
# KINGFISHER_TIMEOUT_S=120
# KINGFISHER_RECURSION_LIMIT=150

# M2 capabilities. Each flag gates the middleware AND its prompt section, so
# the agent is never told about something it cannot actually do.
# KINGFISHER_SKILLS=true
# KINGFISHER_MEMORY=true
