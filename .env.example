# --- endpoint credentials ---------------------------------------------------
# One variable per endpoint your models.yaml defines, named by its `key_env`.
#
# An endpoint whose variable is unset is dropped with a warning and its models
# go with it, so one catalogue works across a fleet holding different subsets of
# the keys. Startup still refuses a deployment whose *default* model is gone.

MINIMAX_API_KEY=${YOUR_API_KEY}
# OPENAI_API_KEY=${YOUR_API_KEY}

# --- kingfisher -------------------------------------------------------------

# Where kingfisher sends prompts and what it runs there is not set here: it is
# models.yaml, and models.yaml.example is the annotated copy to start from.
#
# Defaults to <workspace>/models.yaml. Point several deployments at one file and
# they share a reviewed catalogue; the example follows it there.
# KINGFISHER_MODELS_FILE=/absolute/path/to/catalogue/models.yaml

# The vocabulary of user groups this deployment declares, and which contain
# which. Who reaches what is written in the definitions themselves -- this file
# is only the names those lines are checked against, so a mistyped group is an
# error rather than a group nobody is in. Defaults to <workspace>/groups.yaml
# and relocates so a fleet shares one set of names.
#
# Writing one turns group access on: every call must then say who is making it
# (--as A,B on the command, groups=[...] in the library, groups=UNSCOPED for a
# call with no caller), and a definition carrying no `groups:` line is reachable
# by everyone -- startup names each one. A file that is present and will not
# parse stops the deployment. See docs/formats.md.
# KINGFISHER_GROUPS_FILE=/absolute/path/to/groups.yaml

# One process serves one workspace. Keep it outside this repository so runtime
# state does not land in kingfisher's own tree.
#
# Use an ABSOLUTE path: `~` resolves against HOME, which is not stable in every
# execution context, and a workspace that silently relocates takes its sessions,
# memory and skills with it.
#
# Nothing here is versioned. What is worth keeping is the authored tier, and
# each of those relocates on its own below: point them at a directory you
# version and the sessions stay disposable.
KINGFISHER_WORKSPACE=/absolute/path/to/kingfisher-workspace

# Where `kingfisher seed` copies definitions FROM -- the opposite direction to
# the catalogue directories below, which say where a definition is read.
#
# Relative, and it resolves against your WORKING DIRECTORY, so it is found from
# the root of a checkout and not from a subdirectory -- the same rule `.env`
# itself follows. `kingfisher seed --from DIR` overrides it for one run.
KINGFISHER_ASSETS=./examples

# Where a session's files are kept when the machine may not keep them. A
# directory.
#
# Unset means the session directory is the only copy, which is right wherever
# this host is allowed to hold data and a silent disaster where it is not: if
# the workspace above is a memory filesystem, everything a session produced goes
# with the process unless this names somewhere it survives. `kingfisher doctor`
# refuses that combination rather than letting a deployment discover it.
# KINGFISHER_SESSION_STORE=/absolute/path/to/kept-sessions

# Where host-side state lives. Both default inside the workspace, which is what
# keeps a workspace self-contained and copyable, and they are the only two roots
# that move -- everything else the agent addresses is a virtual path.
#
#   STATE_DIR    run logs and the thread database   default <workspace>/.kingfisher
#   SCRATCH_DIR  the shell's TMPDIR                 default <STATE_DIR>/tmp
#
# Point SCRATCH_DIR at /tmp for one fixed location per machine. It is created
# 0700 and rejected if it is not ours or is group/world-accessible: /tmp is
# mode 1777, so anything under it would otherwise be readable by every local
# user, and another user can pre-create the name.
# KINGFISHER_STATE_DIR=/absolute/path/to/state
# KINGFISHER_SCRATCH_DIR=/tmp/kingfisher

# Where the four definition catalogues live. All default inside the workspace
# and relocate independently: share the procedures while keeping your own
# delegates, or the reverse. Unlike the session directories these hold authored
# content, so several deployments pointing at one reviewed copy is the point.
#
# TOOLS_DIR is the one worth a second thought: it is *code*, imported into this
# process and deliberately not a backend route, so no file tool reaches it.
# KINGFISHER_AGENTS_DIR=/absolute/path/to/catalogue/agents
# KINGFISHER_SKILLS_DIR=/absolute/path/to/catalogue/skills
# KINGFISHER_SUBAGENTS_DIR=/absolute/path/to/catalogue/subagents
# KINGFISHER_TOOLS_DIR=/absolute/path/to/catalogue/tools

# Extra directories on the agent shell's PATH, colon-separated.
#
# The shell runs with an explicit allowlist rather than the parent environment,
# so it resolves only what is on it: the project's own bin, then
# /usr/bin:/bin:/usr/sbin:/sbin.
# Anything installed elsewhere is invisible until named here, and the failure
# looks like the tool not existing rather than like a PATH problem. Homebrew is
# the usual case on macOS: pdftotext, ripgrep and jq live in /opt/homebrew/bin.
# KINGFISHER_SHELL_PATH_EXTRA=/opt/homebrew/bin

# Which model a delegate runs is not set here either. It is one optional line in
# the subagent's own .yaml, naming an entry in models.yaml:
#
#     model: gpt-5
#
# Omit it and the delegate runs the default.

# --- limits ------------------------------------------------------------------

# How long one shell command or one interpreter run may take. Not the model
# timeout, which is per-model in models.yaml.
# KINGFISHER_EXECUTION_TIMEOUT_S=120
#
# How many graph steps one turn may take. Each agent turn costs two or three.
# KINGFISHER_RECURSION_LIMIT=150

# What one session may consume. These protect the process from one runaway
# session; kingfisher cannot bound a *caller*, because it never knows who is.
#
# A turn's wall clock. RECURSION_LIMIT bounds graph steps and a model call has
# its own timeout; nothing bounds their product. On breach the turn stops
# between steps and returns what it produced, marked -- its files are on disk
# and in the result's manifest either way.
# KINGFISHER_TURN_TIMEOUT_S=3600
#
# How much disk one session may hold. Unset means unbounded, and it is checked
# before a turn starts rather than during one.
# KINGFISHER_SESSION_MAX_BYTES=1073741824
#
# How long an idle session survives, when a janitor calls `reap()` without
# saying.
# KINGFISHER_SESSION_TTL_S=604800

# Whether a turn remembers the one before it. On by default.
#
# Off makes a deployment stateless in the only sense kingfisher can be: no
# checkpointer, so no database to contend on, orphan or vacuum. Files are
# unaffected -- /data, /derived and /memory are on disk and a resumed session
# still finds them; it is the conversation that goes. Worth turning off for a
# request/response API, where a caller sends one task and never follows up.
# KINGFISHER_CONVERSATION=false

# Capabilities. Each flag gates the middleware AND its prompt section, so the
# agent is never told about something it cannot actually do.
# KINGFISHER_SKILLS=true
# KINGFISHER_MEMORY=true

# A JavaScript sandbox the agent can compute in: capped memory and time, no
# filesystem, no network, and reachable tools limited to what the request
# granted -- the one execution surface `execute` can never be, which is why a
# deployment may want both. Dispatching subagents from inside it needs the async
# path.
# KINGFISHER_INTERPRETER=true

# Who keeps `execute` off the rest of the host. The shell is a real shell: it
# runs with your permissions and reaches any file you can, whatever the file
# tools are rooted at. Measured unconfined, it could read this deployment's own
# API keys out of .env, plus ~/.aws and ~/.config/gh -- and `http_fetch` is one
# tool call away from sending them somewhere.
#
#   auto      (default) use whatever the platform offers. macOS: sandbox-exec,
#             denying your home directory while keeping the workspace, the venv
#             and the interpreter readable, and denying writes anywhere but the
#             workspace, $TMPDIR and /dev. Elsewhere: nothing yet, and it says so.
#   external  a container already mounts only the workspace, so nothing is
#             wrapped and nothing is warned about.
#   off       deliberately unconfined. Warned about on every start.
# KINGFISHER_SHELL_SANDBOX=auto

# --- gone, and silently ignored if your .env still sets one ------------------
# Nothing warns about an unknown KINGFISHER_ variable, so a line left here from
# an older deployment does nothing, quietly.
#
#   KINGFISHER_API_STYLE          -> models.yaml, where an endpoint names the
#   KINGFISHER_MODEL                 wire format it speaks and a model names an
#   KINGFISHER_MAX_TOKENS            endpoint, with its params beside it
#   KINGFISHER_TIMEOUT_S          -> KINGFISHER_EXECUTION_TIMEOUT_S above, and
#                                    timeout_s per model in models.yaml
#   KINGFISHER_MODEL_SUBAGENT     -> `model:` in the subagent's own .yaml
#   KINGFISHER_PROVIDER_SUBAGENT  -> the endpoint that model names
