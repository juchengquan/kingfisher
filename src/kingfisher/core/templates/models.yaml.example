# Where kingfisher sends prompts, and what it runs there.
#
# Required. There is no default and no fallback: a default would silently pick a
# destination nobody chose the first time kingfisher is pointed somewhere new,
# and a fallback would make "file absent" look exactly like "file found",
# including when KINGFISHER_DEFINITIONS_DIR points at the wrong folder.
#
# Read from models.yaml in KINGFISHER_DEFINITIONS_DIR, beside the definitions.
# Point several deployments at one folder and they share a reviewed catalogue
# instead of each keeping a copy nobody can audit centrally -- which is why no
# credential appears below. Keys are named, not written, so this file belongs in
# version control and in code review. It says where your prompts go.

# --- endpoints: where traffic can go ----------------------------------------
#
# `api` picks a wire format. It is not a name you invent here: kingfisher ships
# the two below, and a deployment adds its own in Python through
# KINGFISHER_WIRE_FORMATS -- see docs/guides/configuration.md. It is code
# rather than data because a row names a class to import:
#
#   anthropic         Anthropic's wire format. This is the gateway path;
#                     MiniMax and anything else imitating it goes here.
#   openai_responses  OpenAI proper, on the Responses API (/v1/responses).
#
# Note what the second one is not. It is **not** a general OpenAI-compatible
# client, which is why it is not called `openai`: it was, and that name
# promised the thing almost every gateway speaks while delivering the one
# almost none of them do. `/v1/responses` is OpenAI's own; a gateway
# advertising an "OpenAI-compatible" API means `/v1/chat/completions` and will
# fail here.
#
# So a gateway goes on `anthropic`, whatever its vendor calls itself. MiniMax
# publishes both wire formats and the Anthropic one is the entry above; the
# same is true of most gateways worth pointing at.
#
# An `api` this list does not name is refused when the catalogue loads, not
# when a turn starts -- so a typo, or the `openai` this field used to accept,
# stops the deployment with a message naming what it can build.
#
# `base_url` is written here rather than read from a variable, because it is
# topology and not a secret -- and because two gateways speaking one wire format
# could not both be described by a single conventional variable name. That was
# the old KINGFISHER_API_STYLE's hard limit: one endpoint per wire format,
# forever. Several entries may share an `api`, which is the point.
#
# `key` names the endpoint's entry in the keys file KINGFISHER_MODEL_KEYS_FILE
# names, so the key is in neither this file nor the environment. `key_env` names
# a variable holding it instead, for a runtime that hands secrets over that way.
# An endpoint says one of the two. One whose key is missing is dropped with a
# warning and its models go with it, so one file works across a fleet whose
# machines hold different subsets of the keys.
endpoints:
  minimax:
    api: anthropic
    base_url: https://api.minimaxi.com/anthropic
    key: minimax

  # A second endpoint on the *same* wire format -- impossible before this file
  # existed. Uncomment if you run one.
  # vllm:
  #   api: anthropic
  #   base_url: http://localhost:8000
  #   key_env: VLLM_API_KEY

  openai:
    api: openai_responses
    base_url: https://api.openai.com/v1
    key: openai

# --- default: what runs when nothing says otherwise -------------------------
#
# Must name an entry under `models:` below, and one whose endpoint has its key
# on this machine. Startup refuses a deployment where it does not, and says
# which of the two went wrong.
default: MiniMax-M3

# --- models: what can run, and how ------------------------------------------
#
# The key is the model id sent on the wire. This table is **closed**: a name
# absent from it is refused rather than passed through to an endpoint that has
# never heard of it.
#
# Every param is optional. Omitted means the kwarg is *not passed at all*, not
# passed as a default kingfisher chose -- `temperature` above all, where a
# default would silently change what your deployment already does. The two
# exceptions have real defaults, because a missing token ceiling behaves
# differently per vendor and a model timeout has nowhere else to fall back to:
#
#   max_tokens   default 4096. How much the model may *write*, not how much it
#                may read. It is taken off the model's input window before a
#                request is sized, so a window-sized one leaves nothing for the
#                conversation and is refused when the model is built -- for a
#                model whose window is known at all, which means one the provider
#                package has a profile for, or one declaring its own below.
#   timeout_s    default 120. Bounds silence, not total generation: kingfisher
#                streams, and the read clock resets on every chunk.
#   max_retries  unset, which is the SDK's own: 2 for both shipped formats. How
#                many more times a call the provider refused or could not answer
#                is tried, with the SDK's backoff and the provider's retry-after.
#                A turn whose last try is refused stops as model_unavailable.
#   temperature  unset
#   top_p        unset
#   clear_results_at
#                unset, and never sent: it is kingfisher's own. The size, in
#                tokens, at which older tool results and file text in the main
#                agent's conversation start being swapped for a short handle
#                naming where the whole of each still is, until it is under half
#                this. Unset is the smaller of 64000 and half of where deepagents
#                summarizes this model's conversation. Written, it is used as
#                written, and one at or past that point is refused when the model
#                is built, since clearing would never come first. There is no off:
#                the highest it may be almost never clears.
#   extra        forwarded as kwargs, for settings peculiar to one endpoint.
#                Additive only -- it may not name any of the above, nor the chat
#                class's own name for one (`openai_api_key`, `request_timeout`,
#                `default_request_timeout`), which would be ignored or overrule it.
#
#                `profile:` under it is what the model can take: its context
#                window as `max_input_tokens`, and `pdf_inputs: false` for one
#                that cannot read a PDF. deepagents' summarizer sizes itself
#                from the window, and with none summarizes at 170,000 tokens
#                keeping six messages, whatever the model can hold. langchain
#                knows the profiles of the models it ships; a profile here
#                replaces that one whole, so on such a model write every field
#                you mean to keep.
#
# A key this format does not define is refused, not ignored. `max_token:`
# singular would otherwise parse, be dropped, and hand back the default with no
# error anywhere.
models:
  MiniMax-M3:
    endpoint: minimax
    # Room for a whole file in one `write_file`. At 4096 a long one was cut off
    # mid-call and reached the tool without its `content`, and the agent retried the
    # same write a dozen times. Not MiniMax's suggested 131072: deepagents also
    # summarizes once the conversation passes 95% of the window less this, so above a
    # tenth of the window it is this number, not the window, that summarizes sooner.
    max_tokens: 32768
    # langchain has no profile for MiniMax, so this is the only word on its window.
    extra:
      profile:
        max_input_tokens: 1000000

  # Several models behind one gateway is the ordinary case, and the reason
  # endpoints and models are separate tables: move the gateway and you edit one
  # line, not one per model.
  MiniMax-M2.5:
    endpoint: minimax
    max_tokens: 16384
    timeout_s: 60

  gpt-5:
    endpoint: openai
    max_tokens: 32000
    extra:
      reasoning_effort: high

# --- pointing a subagent at one of these ------------------------------------
#
# A subagent or an agent names a model from this table:
#
#     # subagents/summariser.yaml
#     model: MiniMax-M2.5
#
# The endpoint follows from the model, so there is no second line to keep in
# step with it. A name this table does not define is refused at startup, naming
# the file that asked for it.
#
# This is where cost routing lives: reading-heavy delegation on a cheap model,
# and the work that matters on a better one. A definition meant to travel
# between deployments leaves `model:` out, since no vendor's model id means the
# same thing everywhere.
