# The group vocabulary: which group names exist here, and which contain which.
#
# Optional, and that is the difference between this file and `models.yaml`. With
# no `groups.yaml` at all, kingfisher controls nothing by group: every definition
# is reachable by everyone, a `groups:` line anywhere is inert, and a deployment
# behaves as it did before access control existed. Adopting it should be a thing
# you do, not a thing you inherit.
#
# So this arrives as `.example` and is never read. Copy it to `groups.yaml`
# beside this file when you want it, or point `KINGFISHER_GROUPS_FILE` somewhere
# several deployments share.
#
# It is here because `kingfisher seed` will tell you to write it. A definition
# naming a group this workspace does not declare is skipped rather than seeded,
# and the message says to declare it -- naming a file you would otherwise have
# no example of, which is the gap this closes.

# --- what this file is not --------------------------------------------------
#
# It holds no policy. *Who reaches what* is written in the definitions
# themselves, on their own `groups:` lines. What lives here is the two things a
# definition cannot say for itself:
#
#   - that a name is real, so a typo like `groups: [analists]` is refused at
#     startup rather than inventing a group nobody is in and quietly hiding an
#     agent from everyone
#   - that one name stands for several, so a broad group is written once here
#     rather than on every line of every definition, forever

groups:
  # The short form. A group containing nothing else needs no body, and most do
  # not -- `readers: {}` and a bare `- readers` mean the same thing, so a flat
  # vocabulary is fine as a plain list:
  #
  #     groups: [readers, writers, operators]
  #
  # Spelled long here only because the entries below need bodies, and a file
  # that switches form halfway is harder to read than one that does not.
  readers: {}
  writers: {}

  # `contains` says what holding a name *grants*.
  #
  # Somebody in `staff` reaches anything a reader or a writer reaches --
  # including definitions added next year that have never heard of `staff`.
  # That is the whole reason the vocabulary is central rather than inferred from
  # what the definitions happen to mention: without it, a broad group is typed
  # onto every definition and forgotten on exactly one. The one it is forgotten
  # on is the one nobody notices, because the symptom is a person who cannot do
  # a thing they were never told they could.
  staff: {contains: [readers, writers]}

  # `all_of` is the opposite operation: what a caller must hold for a name to
  # *apply*. `senior-writers` is not something anybody is granted -- it is what
  # holding `writers` and `senior` together already adds up to.
  senior: {}
  senior-writers: {all_of: [writers, senior]}
